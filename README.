<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TradeX - Stock Trading App</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, sans-serif;
    }

    body {
      background: #0b1120;
      color: white;
    }

    header {
      height: 70px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 6%;
      background: #111827;
      border-bottom: 1px solid #263244;
    }

    .logo {
      font-size: 25px;
      font-weight: bold;
      color: #38bdf8;
    }

    nav a {
      color: #cbd5e1;
      text-decoration: none;
      margin-left: 25px;
    }

    nav a:hover {
      color: #38bdf8;
    }

    .container {
      width: 88%;
      margin: 30px auto;
    }

    .welcome {
      margin-bottom: 25px;
    }

    .welcome h1 {
      font-size: 30px;
    }

    .welcome p {
      color: #94a3b8;
      margin-top: 8px;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
    }

    .card {
      background: #111827;
      padding: 22px;
      border-radius: 14px;
      border: 1px solid #263244;
    }

    .card p {
      color: #94a3b8;
      margin-bottom: 10px;
    }

    .card h2 {
      font-size: 25px;
    }

    .green {
      color: #22c55e;
    }

    .red {
      color: #ef4444;
    }

    .main {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 20px;
      margin-top: 25px;
    }

    .panel {
      background: #111827;
      border: 1px solid #263244;
      border-radius: 14px;
      padding: 22px;
    }

    .panel h2 {
      margin-bottom: 20px;
    }

    .chart {
      height: 300px;
      position: relative;
      overflow: hidden;
      border-radius: 10px;
      background: #0f172a;
    }

    .chart svg {
      width: 100%;
      height: 100%;
    }

    .stock-list {
      margin-top: 25px;
    }

    .stock {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 15px 5px;
      border-bottom: 1px solid #263244;
    }

    .stock:last-child {
      border-bottom: none;
    }

    .stock-name {
      font-weight: bold;
    }

    .stock-symbol {
      color: #64748b;
      font-size: 13px;
      margin-top: 4px;
    }

    .trade-box label {
      display: block;
      color: #94a3b8;
      margin: 15px 0 7px;
    }

    select,
    input {
      width: 100%;
      padding: 12px;
      border-radius: 8px;
      border: 1px solid #334155;
      background: #0f172a;
      color: white;
      outline: none;
    }

    button {
      width: 48%;
      padding: 12px;
      margin-top: 20px;
      border: none;
      border-radius: 8px;
      color: white;
      font-size: 15px;
      font-weight: bold;
      cursor: pointer;
    }

    .buy {
      background: #16a34a;
    }

    .sell {
      background: #dc2626;
    }

    button:hover {
      opacity: 0.85;
    }

    .history {
      margin-top: 25px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 15px;
    }

    th,
    td {
      text-align: left;
      padding: 14px;
      border-bottom: 1px solid #263244;
    }

    th {
      color: #94a3b8;
    }

    footer {
      text-align: center;
      color: #64748b;
      padding: 30px;
      margin-top: 30px;
    }

    @media (max-width: 900px) {
      .cards {
        grid-template-columns: repeat(2, 1fr);
      }

      .main {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 550px) {
      .cards {
        grid-template-columns: 1fr;
      }

      nav {
        display: none;
      }

      .container {
        width: 92%;
      }
    }
  </style>
</head>

<body>

<header>
  <div class="logo">TradeX</div>

  <nav>
    <a href="#">Dashboard</a>
    <a href="#">Markets</a>
    <a href="#">Portfolio</a>
    <a href="#">History</a>
  </nav>
</header>

<div class="container">

  <div class="welcome">
    <h1>Stock Trading Dashboard 📈</h1>
    <p>Track markets and manage your demo portfolio.</p>
  </div>

  <!-- Dashboard Cards -->
  <div class="cards">

    <div class="card">
      <p>Total Balance</p>
      <h2>₹1,25,450</h2>
      <span class="green">+4.25%</span>
    </div>

    <div class="card">
      <p>Invested</p>
      <h2>₹98,200</h2>
      <span class="green">+₹8,540</span>
    </div>

    <div class="card">
      <p>Available Cash</p>
      <h2>₹27,250</h2>
    </div>

    <div class="card">
      <p>Today's P&L</p>
      <h2 class="green">+₹2,340</h2>
    </div>

  </div>

  <div class="main">

    <!-- Market Section -->
    <div class="panel">

      <h2>Market Overview</h2>

      <div class="chart">

        <svg viewBox="0 0 800 300" preserveAspectRatio="none">

          <polyline
            points="0,230 60,210 120,225 180,170 240,190
                    300,140 360,160 420,110 480,130
                    540,90 600,115 660,65 720,90 800,45"
            fill="none"
            stroke="#22c55e"
            stroke-width="4"
          />

          <line x1="0" y1="250" x2="800" y2="250"
                stroke="#334155"/>

          <line x1="0" y1="180" x2="800" y2="180"
                stroke="#1e293b"/>

          <line x1="0" y1="110" x2="800" y2="110"
                stroke="#1e293b"/>

        </svg>

      </div>

      <div class="stock-list">

        <div class="stock">
          <div>
            <div class="stock-name">Reliance Industries</div>
            <div class="stock-symbol">RELIANCE</div>
          </div>

          <div>
            ₹2,845.20
            <span class="green"> +1.42%</span>
          </div>
        </div>

        <div class="stock">
          <div>
            <div class="stock-name">Tata Consultancy Services</div>
            <div class="stock-symbol">TCS</div>
          </div>

          <div>
            ₹3,912.50
            <span class="green"> +0.85%</span>
          </div>
        </div>

        <div class="stock">
          <div>
            <div class="stock-name">Infosys</div>
            <div class="stock-symbol">INFY</div>
          </div>

          <div>
            ₹1,582.30
            <span class="red"> -0.42%</span>
          </div>
        </div>

        <div class="stock">
          <div>
            <div class="stock-name">HDFC Bank</div>
            <div class="stock-symbol">HDFCBANK</div>
          </div>

          <div>
            ₹1,742.80
            <span class="green"> +0.63%</span>
          </div>
        </div>

      </div>
    </div>

    <!-- Buy / Sell Section -->
    <div class="panel trade-box">

      <h2>Place Demo Order</h2>

      <label>Stock</label>

      <select id="stock">
        <option value="RELIANCE">Reliance Industries</option>
        <option value="TCS">TCS</option>
        <option value="INFY">Infosys</option>
        <option value="HDFCBANK">HDFC Bank</option>
      </select>

      <label>Quantity</label>

      <input
        type="number"
        id="quantity"
        placeholder="Enter quantity"
        min="1"
      >

      <label>Order Type</label>

      <select id="orderType">
        <option>Market</option>
        <option>Limit</option>
      </select>

      <div>
        <button class="buy" onclick="placeOrder('BUY')">
          BUY
        </button>

        <button class="sell" onclick="placeOrder('SELL')">
          SELL
        </button>
      </div>

      <p id="message"
         style="margin-top:20px;color:#94a3b8;">
      </p>

    </div>

  </div>

  <!-- Portfolio -->
  <div class="panel history">

    <h2>My Portfolio</h2>

    <table>

      <thead>
        <tr>
          <th>Stock</th>
          <th>Qty</th>
          <th>Avg. Price</th>
          <th>Current Price</th>
          <th>P&L</th>
        </tr>
      </thead>

      <tbody>

        <tr>
          <td>RELIANCE</td>
          <td>10</td>
          <td>₹2,700</td>
          <td>₹2,845.20</td>
          <td class="green">+₹1,452</td>
        </tr>

        <tr>
          <td>TCS</td>
          <td>5</td>
          <td>₹3,750</td>
          <td>₹3,912.50</td>
          <td class="green">+₹812.50</td>
        </tr>

        <tr>
          <td>INFY</td>
          <td>8</td>
          <td>₹1,620</td>
          <td>₹1,582.30</td>
          <td class="red">-₹301.60</td>
        </tr>

      </tbody>

    </table>

  </div>

</div>

<footer>
  TradeX © 2026 | Educational Demo Project
</footer>

<script>

  function placeOrder(type) {

    const stock =
      document.getElementById("stock").value;

    const quantity =
      document.getElementById("quantity").value;

    const message =
      document.getElementById("message");

    if (quantity === "" || quantity <= 0) {

      message.innerHTML =
        "⚠️ Please enter a valid quantity.";

      return;
    }

    message.innerHTML =
      "✅ Demo " + type +
      " order placed for " +
      quantity + " shares of " +
      stock + ".";

    document.getElementById("quantity").value = "";

  }

</script>

</body>
</html>
